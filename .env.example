# Backend API URL (required). Server-side only: the browser talks to the /api BFF.
# For local development without Docker: http://localhost:3001/api/v1
# For Docker (cross-container): http://express-core-api:3001/api/v1
# For production: https://api.example.com/api/v1
API_URL=http://express-core-api:3001/api/v1

# Optional, comma-separated public media URLs for next/image (origin or path prefix).
# Read at build time: rebuild after changing it. API_URL already allows
# <API host>/storage/uploads/**. Add the backend's public storage URL when the browser
# reaches the backend on another host than API_URL (e.g. Docker), or when it serves
# files elsewhere. An origin alone allows every path on that exact host.
# MEDIA_URL=https://api.example.com/storage,https://cdn.example.com/images
